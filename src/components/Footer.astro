---
// One footer everywhere (user override, 2026-08-23 — see Mistake log for
// the two-variant version this replaced). Structure/copy is the homepage's
// own design (legacy/index.html:3810, rewritten against `.mod-footer` per
// step 3): Company keeps all three links (About/Why Us/Contact) and the
// floating WhatsApp FAB renders on every page, not just home.
//
// Hrefs still adapt to where the page actually is — Platform/Industry are
// in-page anchors on "/" and cross-page "/#anchor" everywhere else, and
// Inventory/Logistics always point at their real pages. Copying literal
// legacy `href="#"` placeholders onto every page site-wide would just
// multiply the one dead link legacy already had (rule 6).
import { Image } from "astro:assets";
import logo from "@/assets/nexone-logo.png";
import { withBase } from "@/lib/base";

const isHomePage = Astro.url.pathname === withBase("/");
const platformHref = isHomePage ? "#platform" : withBase("/#platform");
const industryHref = isHomePage ? "#industry" : withBase("/#industry");
---

<footer class="mod-footer" id="footer">
  <div class="container mod-footer-grid">
    <div class="footer-col footer-col--brand">
      <span class="mod-footer-logo">
        <Image src={logo} alt="Nexone World" width={320} quality={80} loading="lazy" decoding="async" />
      </span>
      <p class="footer-tagline">
        We help you navigate the complexities of modern business with our advanced enterprise software solutions.
      </p>
      <div class="footer-social">
        <a href="#" aria-label="WhatsApp">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.42-1.42a9.87 9.87 0 0 0 4.62 1.18h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.64-1.03-5.13-2.9-7C16.99 3.03 14.68 2 12.04 2zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.55-3.7 8.2-8.25 8.2zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.99-1.22-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.55c.12.17 1.73 2.64 4.2 3.7.59.25 1.05.4 1.41.51.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z" />
          </svg>
        </a>
        <a href="#" aria-label="Facebook">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-8.02h2.69l.4-3.12h-3.09V7.94c0-.9.25-1.52 1.55-1.52h1.65V3.62c-.29-.04-1.27-.12-2.42-.12-2.39 0-4.03 1.46-4.03 4.14v2.32H7.5v3.12h2.75V21h3.25z" />
          </svg>
        </a>
        <a href="#" aria-label="TikTok">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.5 2c.3 2.1 1.62 3.6 3.5 3.75v3.02c-1.24.11-2.35-.28-3.5-1.03v6.4c0 3.24-2.63 5.86-5.86 5.86A5.86 5.86 0 0 1 4.78 14.14c0-3.16 2.5-5.75 5.63-5.86v3.11a2.77 2.77 0 1 0 2 2.67V2h4.09z" />
          </svg>
        </a>
      </div>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li><a href={withBase("/about")}>About Us</a></li>
        <li><a href={withBase("/why-us")}>Why Us</a></li>
        <li><a href={withBase("/contact")}>Contact Us</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Solutions</h4>
      <ul>
        <li><a href={withBase("/modules/inventory")}>Inventory</a></li>
        <li><a href={withBase("/modules/logistics")}>Logistics</a></li>
        <li><a href={platformHref}>Integrated Finance</a></li>
        <li><a href={platformHref}>Payroll</a></li>
        <li><a href={platformHref}>POS System</a></li>
        <li><a href={platformHref}>Custom Modules</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Services</h4>
      <ul>
        <li><a href={industryHref}>Accounting</a></li>
        <li><a href={industryHref}>Web Development</a></li>
        <li><a href={industryHref}>Digital Marketing</a></li>
        <li><a href={industryHref}>Web Hosting</a></li>
        <li><a href={industryHref}>Content Writing</a></li>
      </ul>
    </div>
  </div>
  <div class="container mod-footer-bottom">
    <span class="mod-footer-copy">&copy; 2026 Nexone World. Established 2000.</span>
    <a class="mod-footer-email" href="mailto:info@nexoneworld.com">info@nexoneworld.com</a>
  </div>
  {/* Floating message/WhatsApp FAB — commented out on request (2026-08-27).
      Styles kept in sync: `.footer-fab` in styles/sections/footer.css is
      commented out too. Restore both together.
  <a aria-label="Contact on WhatsApp" class="footer-fab" href="#">
    <svg viewBox="0 -960 960 960" width="28" height="28" fill="currentColor" aria-hidden="true">
      <path d="M240-400h320v-80H240v80Zm0-120h480v-80H240v80Zm0-120h480v-80H240v80ZM80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z" />
    </svg>
  </a>
  */}
</footer>
