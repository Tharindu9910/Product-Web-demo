---
// No legacy source — payroll.html never existed. Lean template, same
// structure as modules/logistics.astro. Hero lede and benefit titles are
// modules.json's existing approved panelText/benefits for "payroll"; the
// per-benefit sentences below are new copy written to expand those titles.
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { withBase } from "@/lib/base";
import ClosingCTA from "@/components/ClosingCTA.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import payrollPhoto from "@/assets/card/Payroll.jpg";
import payrollCtaPhoto from "@/assets/erp-modules/payroll.jpg";
import "@/styles/pages/module-page.css";
---

<Base
  title="Payroll | NexOne"
  description="Run payroll for any team size without spreadsheets — hours, leave, deductions and statutory contributions calculate automatically, every cycle."
>
  <Fragment slot="nav">
    <Nav variant="page" current="modules" />
  </Fragment>

  <section class="mod-hero section">
    <div class="container">
      <p class="mod-breadcrumb">
        <a href={withBase("/#platform")}>ERP Modules</a>
        <svg class="icon icon--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        <span>Payroll</span>
      </p>
      <div class="mod-hero-grid">
        <div data-anim="fade-up">
          <Eyebrow>Core module</Eyebrow>
          <h1 class="mod-title">Payroll</h1>
          <p class="lede mod-lede">
            Run payroll for any team size without spreadsheets — hours, leave, deductions and statutory
            contributions calculate automatically, every cycle.
          </p>
          <div class="mod-cta-row">
            <a class="mod-btn-primary" href={withBase("/contact")}>Request a demo</a>
          </div>
        </div>
        <div class="mod-hero-media" data-anim="fade-up" data-anim-delay="0.15">
          <Image src={payrollPhoto} alt="Payroll module interface"
            width={1200}
            widths={[420, 640, 900, 1200]}
            sizes="(max-width: 1023px) calc(100vw - 48px), 600px"
            quality={68}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mod-benefits section">
    <div class="container">
      <div class="mod-benefits-head" data-anim="fade-up">
        <Eyebrow>What it does</Eyebrow>
        <h2>Every run, calculated for you.</h2>
      </div>
      <div class="mod-benefits-grid" data-anim="stagger">
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Automated salary calculation</h3>
          </div>
          <p>Base pay, overtime and adjustments calculate from attendance data, with no manual spreadsheet work each cycle.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Leave &amp; attendance tracking</h3>
          </div>
          <p>Leave balances and attendance feed straight into payroll, so entitlements and deductions always agree.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Statutory compliance built in</h3>
          </div>
          <p>Statutory contributions and deductions apply automatically, kept current with local requirements.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Payslip generation &amp; distribution</h3>
          </div>
          <p>Payslips generate and distribute to staff automatically at the end of every run.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Multi-branch payroll support</h3>
          </div>
          <p>Run payroll for multiple branches or locations from the same system, on the same schedule.</p>
        </div>
      </div>
    </div>
  </section>

  <ClosingCTA image={payrollCtaPhoto}>
    <Fragment slot="title">See Payroll running<br />for your own team.</Fragment>
  </ClosingCTA>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</Base>
