---
// Two designs, one component (CLAUDE.md step 3):
// - "home"  — legacy/index.html:2366. Transparent over the hero, gets
//   is-scrolled + scroll-spy from the script below (both keyed off DOM
//   elements — #hero and [data-nav] sections — that only exist on this page).
// - "page"  — legacy/about.html:365 (identical across all 5 subpages except
//   the aria-current target). Opaque from the top: statically wears the same
//   .is-scrolled class the home variant only gets on scroll, rather than
//   duplicating that rule under a new name (rule 2).
//
// `current` only matters for the page variant — legacy's homepage nav has no
// static aria-current at all; the scroll-spy script sets it at runtime.
// inventory/logistics have no nav item of their own, so they light up
// "ERP Modules" (legacy/inventory.html's nav does the same).
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import logo from "@/assets/nexone-logo.png";
import { withBase } from "@/lib/base";

interface Props {
  variant: "home" | "page";
  current?: "about" | "contact" | "why-us" | "modules";
}
const { variant, current } = Astro.props;
const isHome = variant === "home";

const homeHref = isHome ? "#hero" : withBase("/#hero");
const platformHref = isHome ? "#platform" : withBase("/#platform");
const otherServicesHref = isHome ? "#platform-explorer" : withBase("/#platform-explorer");
const architectureHref = isHome ? "#architecture" : withBase("/#architecture");

// Hover/tap dropdown under "ERP Modules" — each of the six links straight
// to its dedicated /modules/* page (user request, 2026-08-27; no legacy
// precedent for a nav dropdown, logged per CLAUDE.md rule 1's carve-out).
const erpModules = (await getCollection("modules"))
  .filter((m) => m.data.kind === "erp-module")
  .sort((a, b) => a.data.order - b.data.order);
---

<nav class={`site-nav${isHome ? "" : " is-scrolled"}`} id="site-nav">
  <div class="nav-inner">
    <a class="nav-brand" href={homeHref} aria-label="Nexone World — home">
      <Image src={logo} alt="Nexone World" width={400} quality={80} decoding="async" />
      {<span class="nav-descriptor">ERP</span>}
    </a>
    <ul class="nav-links" id="nav-links">
      <li><a href={homeHref} data-nav={isHome ? "hero" : undefined}>Home</a></li>
      <li class="nav-item has-dropdown">
        <span class="nav-item-row">
          <a
            href={platformHref}
            data-nav={isHome ? "platform" : undefined}
            aria-current={current === "modules" ? "true" : undefined}
            aria-haspopup="true"
            aria-expanded="false"
          >
            ERP Modules
          </a>
          <button
            type="button"
            class="nav-dropdown-toggle"
            aria-expanded="false"
            aria-controls="nav-dropdown-erp"
            aria-label="Toggle ERP Modules menu"
          >
            <svg class="icon icon--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
        </span>
        <div class="nav-dropdown-hitbox">
          <ul class="nav-dropdown" id="nav-dropdown-erp" role="menu">
            {erpModules.map((mod) => (
              <li role="none">
                <a role="menuitem" href={withBase(mod.data.href)}>{mod.data.name}</a>
              </li>
            ))}
          </ul>
        </div>
      </li>
      <li><a href={otherServicesHref} data-nav={isHome ? "platform-explorer" : undefined}>Other Services</a></li>
      <li><a href={architectureHref} data-nav={isHome ? "architecture" : undefined}>Architecture</a></li>
      <li><a href={withBase("/why-us")} aria-current={current === "why-us" ? "true" : undefined}>Why Us</a></li>
      <li><a href={withBase("/about")} aria-current={current === "about" ? "true" : undefined}>About</a></li>
      <li><a href={withBase("/contact")} aria-current={current === "contact" ? "true" : undefined}>Contact</a></li>
    </ul>
    <a class="nav-cta" href={withBase("/contact")}>Book a Demo</a>
    <button class="nav-toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
  </div>
</nav>

<script>
  // No imports on purpose. This script runs on every page, so anything it
  // imports lands on every page's critical path — which is how the whole
  // GSAP bundle used to get pulled in just to fade the mobile menu. That
  // fade is now a CSS transition on `.nav-links` / `.nav-links.is-open`
  // (base/responsive.css), scoped inside the max-width:1023px block.

  // legacy/index.html's nav IIFE (4d), trimmed to nav concerns — Platform's
  // own state machine stays where it's built (step 7 island). Every observer
  // below is guarded by the element existing, so the same script is safe on
  // both variants: the page variant simply has no #hero / [data-nav] targets
  // and the guards no-op.
  //
  // is-scrolled is keyed off scroll position, not hero visibility (deviates
  // from legacy's #hero IntersectionObserver, user override 2026-08-26): the
  // white background should appear on the first scroll, not only once the
  // whole hero section has scrolled out of view. Still guarded on #hero's
  // presence — the page variant has no hero and wears is-scrolled statically
  // from the start, so this must stay a no-op there or it would strip that
  // static class the moment setScrolled() runs at scrollY 0.
  const nav = document.getElementById("site-nav");
  const hero = document.getElementById("hero");
  if (nav && hero) {
    const setScrolled = () => nav.classList.toggle("is-scrolled", window.scrollY > 10);
    setScrolled();
    window.addEventListener("scroll", setScrolled, { passive: true });
  }

  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-links a[data-nav]");
  const spied = ["hero", "platform", "platform-explorer", "architecture"]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  function setActive(id: string | null) {
    navLinks.forEach((link) => {
      if (id && link.getAttribute("data-nav") === id) {
        link.setAttribute("aria-current", "true");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  if (spied.length && "IntersectionObserver" in window) {
    const visible: Record<string, boolean> = {};
    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible[entry.target.id] = entry.isIntersecting;
        });
        let current: string | null = null;
        spied.forEach((section) => {
          if (visible[section.id]) current = section.id;
        });
        setActive(current);
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
    );
    spied.forEach((section) => spyObserver.observe(section));
  }

  // "ERP Modules" dropdown: CSS alone handles the hover reveal (gated to
  // `(hover: hover) and (pointer: fine)`, see nav.css — matches this
  // component's other hover trap). This JS only covers the case CSS
  // :hover can't: a tap on touch/no-hover devices, where the toggle
  // button below is the sole way to reach the submenu.
  function closeDropdowns() {
    document.querySelectorAll<HTMLLIElement>(".nav-item.has-dropdown.is-open").forEach((item) => {
      item.classList.remove("is-open");
      item.querySelectorAll("[aria-expanded]").forEach((el) => el.setAttribute("aria-expanded", "false"));
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".nav-dropdown-toggle").forEach((toggle) => {
    const item = toggle.closest<HTMLLIElement>(".nav-item");
    const link = item?.querySelector<HTMLAnchorElement>(".nav-item-row a");
    if (!item) return;
    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const open = !item.classList.contains("is-open");
      closeDropdowns();
      item.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      link?.setAttribute("aria-expanded", String(open));
    });
  });

  document.addEventListener("click", (event) => {
    if (!(event.target as HTMLElement).closest(".nav-item.has-dropdown")) closeDropdowns();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeDropdowns();
  });

  const navToggle = document.getElementById("nav-toggle");
  const navList = document.getElementById("nav-links");
  if (navToggle && navList) {
    navToggle.addEventListener("click", () => {
      const open = navList.classList.toggle("is-open");
      navToggle.setAttribute("aria-expanded", String(open));
      if (!open) closeDropdowns();
    });
    navList.addEventListener("click", (event) => {
      // Guarded on is-open, not just "was a link clicked" — on desktop this
      // fires on every nav link click too. The GSAP autoAlpha that made that
      // actively destructive is gone (the fade is CSS now, scoped to the
      // mobile breakpoint, so it cannot leak onto the desktop nav the way
      // inline styles did — see the 2026-08-27 mistake-log entry). The guard
      // stays regardless: desktop has no open menu to close, and firing
      // closeDropdowns() on every desktop nav click would shut the ERP
      // Modules submenu as the pointer moved into it.
      if ((event.target as HTMLElement).closest("a") && navList.classList.contains("is-open")) {
        navList.classList.remove("is-open");
        navToggle.setAttribute("aria-expanded", "false");
        closeDropdowns();
      }
    });
  }
</script>
