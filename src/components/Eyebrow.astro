---
// Legacy uses both <p class="eyebrow"> and <span class="eyebrow ..."> depending
// on context (hero-eyebrow-brand is a span; every section head is a p).
interface Props {
  as?: "p" | "span";
  class?: string;
}
const { as: Tag = "p", class: className } = Astro.props;
---

<Tag class={["eyebrow", className].filter(Boolean).join(" ")}>
  <slot />
</Tag>
