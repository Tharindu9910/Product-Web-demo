---
// No legacy source — pos.html never existed. Lean template, same
// structure as modules/logistics.astro. Hero lede and benefit titles are
// modules.json's existing approved panelText/benefits for "pos"; the
// per-benefit sentences below are new copy written to expand those titles.
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { withBase } from "@/lib/base";
import ClosingCTA from "@/components/ClosingCTA.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import posPhoto from "@/assets/card/PosSystem.jpg";
import posCtaPhoto from "@/assets/erp-modules/pos_system.jpg";
import "@/styles/pages/module-page.css";
---

<Base
  title="POS System | NexOne"
  description="A fast, reliable checkout that talks to stock and finance the moment a sale happens — so what's on the shelf and what's in the books always agree."
>
  <Fragment slot="nav">
    <Nav variant="page" current="modules" />
  </Fragment>

  <section class="mod-hero section">
    <div class="container">
      <p class="mod-breadcrumb">
        <a href={withBase("/#platform")}>ERP Modules</a>
        <svg class="icon icon--sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        <span>POS System</span>
      </p>
      <div class="mod-hero-grid">
        <div data-anim="fade-up">
          <Eyebrow>Core module</Eyebrow>
          <h1 class="mod-title">POS System</h1>
          <p class="lede mod-lede">
            A fast, reliable checkout that talks to stock and finance the moment a sale happens — so what's
            on the shelf and what's in the books always agree.
          </p>
          <div class="mod-cta-row">
            <a class="mod-btn-primary" href={withBase("/contact")}>Request a demo</a>
          </div>
        </div>
        <div class="mod-hero-media" data-anim="fade-up" data-anim-delay="0.15">
          <Image src={posPhoto} alt="POS System module interface"
            width={1200}
            widths={[420, 640, 900, 1200]}
            sizes="(max-width: 1023px) calc(100vw - 48px), 600px"
            quality={68}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="mod-benefits section">
    <div class="container">
      <div class="mod-benefits-head" data-anim="fade-up">
        <Eyebrow>What it does</Eyebrow>
        <h2>Counter sales, on the same record.</h2>
      </div>
      <div class="mod-benefits-grid" data-anim="stagger">
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Fast, offline-capable checkout</h3>
          </div>
          <p>Checkout keeps working through a connection drop, and syncs the moment it's back online.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Real-time stock sync</h3>
          </div>
          <p>Every sale updates stock immediately, so the shelf and the system never fall out of step.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Multiple payment methods</h3>
          </div>
          <p>Accept cash, card and mobile payment at the same till, recorded against the same sale record.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Staff &amp; till management</h3>
          </div>
          <p>Assign staff to tills with their own login, and track performance and cash handling per shift.</p>
        </div>
        <div class="mod-benefit-card">
          <div class="mod-benefit-head">
            <span class="mod-benefit-icon"><svg class="icon icon--xs" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.5 2.5L16 9.5"></path></svg></span>
            <h3>Instant sales reporting</h3>
          </div>
          <p>See sales by till, staff or product as they happen, with no end-of-day export needed.</p>
        </div>
      </div>
    </div>
  </section>

  <ClosingCTA image={posCtaPhoto}>
    <Fragment slot="title">See POS running<br />on your own counter.</Fragment>
  </ClosingCTA>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</Base>
